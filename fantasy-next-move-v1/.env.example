# The app runs in demo mode and supports public Sleeper import without secrets.

# Yahoo Fantasy OAuth (required for Yahoo connection)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Local default: http://localhost:3000/api/yahoo/callback
YAHOO_REDIRECT_URI=
# Use a long random value; for example: openssl rand -base64 48
FNM_COOKIE_SECRET=

# Optional production services / future hosted-account persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_MONTHLY_PRICE_ID=
